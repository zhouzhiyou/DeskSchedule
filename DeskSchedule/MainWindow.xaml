<Window x:Class="DeskSchedule.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeskSchedule.ViewModels"
        xmlns:models="clr-namespace:DeskSchedule.Models"
        Title="日程管理"
        Width="380" Height="550"
        MinWidth="320" MinHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding WindowAlwaysOnTop}"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        Icon="pack://application:,,,/Assets/tray_icon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 已完成日程样式 -->
        <Style x:Key="CompletedScheduleTitle" TargetType="TextBlock">
            <Setter Property="TextDecorations" Value="Strikethrough"/>
            <Setter Property="Foreground" Value="#999"/>
        </Style>

        <!-- 筛选按钮样式 -->
        <Style x:Key="FilterButton" TargetType="RadioButton">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#1976D2"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 优先级颜色转换器 -->
        <vm:PriorityToColorConverter x:Key="PriorityColor"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding HideWindowCommand}"/>
    </Window.InputBindings>

    <Border x:Name="MainBorder" CornerRadius="10" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1"
            Opacity="{Binding WindowOpacity}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="BorderTransform" X="0"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="#2196F3" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="📅 日程管理" Foreground="White" FontSize="14"
                          Margin="15,10" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,5">
                    <Button Content="─" Width="30" Height="25" Click="Minimize_Click"
                           Style="{StaticResource TitleBarButton}"/>
                    <Button Content="×" Width="30" Height="25" Click="Close_Click"
                           Style="{StaticResource TitleBarButton}"/>
                </StackPanel>
            </Grid>

            <!-- 搜索栏 -->
            <Grid Grid.Row="1" Margin="10,10,10,5">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Padding="30,8,8,8" VerticalContentAlignment="Center"
                        Style="{StaticResource SearchTextBox}"/>
                <TextBlock Text="🔍" Margin="12,0,0,0" VerticalAlignment="Center"
                          Foreground="#999" IsHitTestVisible="False"/>
            </Grid>

            <!-- 筛选按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,5" HorizontalAlignment="Center">
                <RadioButton Content="全部" Style="{StaticResource FilterButton}" IsChecked="True"
                            Command="{Binding SetFilterAllCommand}" GroupName="Filter"/>
                <RadioButton Content="待完成" Style="{StaticResource FilterButton}"
                            Command="{Binding SetFilterPendingCommand}" GroupName="Filter" Margin="5,0,0,0"/>
                <RadioButton Content="已完成" Style="{StaticResource FilterButton}"
                            Command="{Binding SetFilterCompletedCommand}" GroupName="Filter" Margin="5,0,0,0"/>
            </StackPanel>

            <!-- 日程列表（按日期分组） -->
            <ScrollViewer Grid.Row="3" Margin="10,5">
                <ItemsControl ItemsSource="{Binding GroupedSchedules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:DateGroup">
                            <StackPanel>
                                <!-- 日期标题 -->
                                <Border Background="#E3F2FD" CornerRadius="4" Margin="0,10,0,5" Padding="10,5">
                                    <TextBlock Text="{Binding DisplayText}" FontWeight="Bold" FontSize="12" Foreground="#1976D2"/>
                                </Border>

                                <!-- 该日期下的日程 -->
                                <ItemsControl ItemsSource="{Binding Schedules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:Schedule">
                                            <Border Background="White" CornerRadius="5" Margin="0,3"
                                                   BorderBrush="#E0E0E0" BorderThickness="1"
                                                   MouseLeftButtonDown="ScheduleItem_MouseLeftButtonDown"
                                                   Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="编辑"
                                                                  Command="{Binding PlacementTarget.Tag.EditScheduleCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="完成"
                                                                  Command="{Binding PlacementTarget.Tag.CompleteScheduleCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}"
                                                                  Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVis}}"/>
                                                        <MenuItem Header="取消完成"
                                                                  Command="{Binding PlacementTarget.Tag.UncompleteScheduleCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}"
                                                                  Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="删除"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteScheduleCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>

                                                <Grid Margin="12,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 完成状态勾选框 -->
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}"
                                                             Margin="0,0,10,0" Width="18"
                                                             Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="{Binding}"/>

                                                    <!-- 标题和时间 -->
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <!-- 优先级标记 -->
                                                            <Border Background="{Binding Priority, Converter={StaticResource PriorityColor}}"
                                                                   CornerRadius="3" Width="20" Height="18"
                                                                   Margin="0,0,6,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVis}}">
                                                                <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityText}}"
                                                                          FontSize="10" Foreground="White" FontWeight="Bold"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"
                                                                      TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="TextDecorations" Value="None"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                                <Setter Property="Foreground" Value="#999"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding RemindTime, StringFormat='{}{0:HH:mm}'}"
                                                                  FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <!-- 提醒类型图标 -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🔔" FontSize="12" Visibility="{Binding IsPopupReminder,
                                                            Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="🔊" FontSize="12" Margin="3,0,0,0" Visibility="{Binding IsSoundReminder,
                                                            Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 透明度滑块 -->
            <Grid Grid.Row="4" Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="透明度:" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <Slider Grid.Column="1" Minimum="0.1" Maximum="1" Value="{Binding WindowOpacity}"
                       TickFrequency="0.1" IsSnapToTickEnabled="True"
                       VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="{Binding WindowOpacity, StringFormat='{}{0:P0}'}"
                          VerticalAlignment="Center" Width="40" TextAlignment="Right"/>
            </Grid>

            <!-- 底部按钮栏 -->
            <Grid Grid.Row="5" Margin="10,5,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="+ 添加日程" Command="{Binding AddScheduleCommand}"
                       Style="{StaticResource PrimaryButton}" Margin="0,0,5,0"/>

                <Button Grid.Column="1" Content="⚙" Width="35" Command="{Binding OpenSettingsCommand}"
                       Style="{StaticResource IconButton}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
