<Window x:Class="DeskSchedule.Views.GuideView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskSchedule 使用指南"
        Width="520" Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#F5F5F5"
        Icon="pack://application:,,,/Assets/tray_icon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部装饰条 -->
        <Border Grid.Row="0" Height="4" Background="#2196F3"/>

        <!-- 内容区域 -->
        <StackPanel Grid.Row="1" x:Name="ContentPanel" Margin="40,30,40,20">
            <!-- 图标 -->
            <Border x:Name="IconBorder" Width="80" Height="80" CornerRadius="40" Margin="0,0,0,20"
                   Background="#2196F3" HorizontalAlignment="Center">
                <TextBlock x:Name="IconText" Text="📅" FontSize="36"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- 标题 -->
            <TextBlock x:Name="TitleText" Text="欢迎使用" FontSize="24" FontWeight="Bold"
                      HorizontalAlignment="Center" Foreground="#333"/>

            <!-- 副标题 -->
            <TextBlock x:Name="SubtitleText" Text="轻量级桌面日程管理工具" FontSize="14"
                      HorizontalAlignment="Center" Foreground="#666" Margin="0,5,0,20"/>

            <!-- 描述 -->
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <TextBlock x:Name="DescriptionText" Text="描述内容" FontSize="14"
                          Foreground="#444" TextWrapping="Wrap" LineHeight="24"
                          HorizontalAlignment="Center" TextAlignment="Center"/>
            </Border>

            <!-- 进度指示器 -->
            <StackPanel x:Name="ProgressPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="White" Padding="30,15" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <CheckBox x:Name="DontShowCheckBox" Content="不再显示此引导"
                             VerticalAlignment="Center" Foreground="#666"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SkipButton" Content="跳过" Width="80" Height="32"
                           Click="SkipButton_Click" Margin="0,0,10,0"
                           Background="Transparent" BorderBrush="#CCCCCC" BorderThickness="1">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                   BorderBrush="{TemplateBinding BorderBrush}"
                                                   BorderThickness="{TemplateBinding BorderThickness}"
                                                   CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F0F0F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="PrevButton" Content="上一步" Width="80" Height="32"
                           Click="PrevButton_Click" Margin="0,0,10,0"
                           Background="Transparent" BorderBrush="#2196F3" Foreground="#2196F3" BorderThickness="1">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                   BorderBrush="{TemplateBinding BorderBrush}"
                                                   BorderThickness="{TemplateBinding BorderThickness}"
                                                   CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E3F2FD"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="NextButton" Content="下一步" Width="80" Height="32"
                           Click="NextButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                   CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1976D2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
