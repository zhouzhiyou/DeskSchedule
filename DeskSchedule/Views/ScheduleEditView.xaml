<Window x:Class="DeskSchedule.Views.ScheduleEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DeskSchedule.Models"
        Title="编辑日程" Width="400" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Icon="pack://application:,,,/Assets/tray_icon.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="标题:" VerticalAlignment="Center" Width="80"/>
            <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                    Padding="8" VerticalContentAlignment="Center"/>
        </Grid>

        <!-- 描述 -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="描述:" VerticalAlignment="Top" Width="80" Margin="0,8,0,0"/>
            <TextBox Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                    Padding="8" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                    VerticalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- 提醒时间 -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="提醒时间:" VerticalAlignment="Center" Width="80"/>
            <DatePicker Grid.Column="1" SelectedDate="{Binding RemindDate}"
                       Margin="0,0,5,0" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding HourOptions}"
                     SelectedItem="{Binding SelectedHour}" Width="60" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock Grid.Column="3" Text=":" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox Grid.Column="3" ItemsSource="{Binding MinuteOptions}"
                     SelectedItem="{Binding SelectedMinute}" Width="60" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </Grid>

        <!-- 优先级 -->
        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="优先级:" VerticalAlignment="Center" Width="80"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Content="低" GroupName="Priority" Margin="0,0,15,0"
                            IsChecked="{Binding IsPriorityLow, Mode=TwoWay}"
                            Style="{StaticResource PriorityRadioButton}"/>
                <RadioButton Content="普通" GroupName="Priority" Margin="0,0,15,0"
                            IsChecked="{Binding IsPriorityNormal, Mode=TwoWay}"
                            Style="{StaticResource PriorityRadioButton}"/>
                <RadioButton Content="高" GroupName="Priority" Margin="0,0,15,0"
                            IsChecked="{Binding IsPriorityHigh, Mode=TwoWay}"
                            Style="{StaticResource PriorityRadioButton}"/>
                <RadioButton Content="紧急" GroupName="Priority"
                            IsChecked="{Binding IsPriorityUrgent, Mode=TwoWay}"
                            Style="{StaticResource PriorityRadioButton}"/>
            </StackPanel>
        </Grid>

        <!-- 提醒方式 -->
        <GroupBox Grid.Row="4" Header="提醒方式" Padding="10" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="弹窗提醒" IsChecked="{Binding IsPopupReminder}"
                         Margin="0,0,20,0"/>
                <CheckBox Content="声音提醒" IsChecked="{Binding IsSoundReminder}"/>
            </StackPanel>
        </GroupBox>

        <!-- 自定义提醒文本 -->
        <Grid Grid.Row="5" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="自定义文本:" VerticalAlignment="Center" Width="80"/>
            <TextBox Grid.Column="1" Text="{Binding RemindText}"
                    Padding="8" VerticalContentAlignment="Center"/>
        </Grid>

        <!-- 自定义声音 -->
        <Grid Grid.Row="6" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="自定义声音:" VerticalAlignment="Center" Width="80"/>
            <TextBox Grid.Column="1" Text="{Binding RemindSoundPath}"
                    IsReadOnly="True" Margin="0,0,5,0"/>
            <Button Grid.Column="2" Content="浏览..." Command="{Binding BrowseSoundCommand}"
                   Padding="10,5"/>
        </Grid>

        <!-- 占位 -->
        <Grid Grid.Row="7"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Command="{Binding CancelCommand}"
                   Padding="20,8" Margin="0,0,10,0"/>
            <Button Content="保存" Command="{Binding SaveCommand}"
                   Style="{StaticResource PrimaryButton}" Padding="20,8"/>
        </StackPanel>
    </Grid>
</Window>
