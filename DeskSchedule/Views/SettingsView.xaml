<Window x:Class="DeskSchedule.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="400" Height="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Icon="pack://application:,,,/Assets/tray_icon.ico">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- 自动隐藏设置 -->
            <GroupBox Header="自动隐藏" Padding="10" Margin="0,0,0,15">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="隐藏延迟（秒）:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Width="80" Text="{Binding HideDelaySeconds}"
                                VerticalContentAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- 鼠标触发设置 -->
            <GroupBox Header="鼠标触发" Padding="10" Margin="0,0,0,15">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="触发区域大小（像素）:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Width="80" Text="{Binding TriggerAreaSize}"
                                VerticalContentAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="触发延迟（毫秒）:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Width="80" Text="{Binding TriggerDelayMs}"
                                VerticalContentAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- 窗口设置 -->
            <GroupBox Header="窗口设置" Padding="10" Margin="0,0,0,15">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="透明度:" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding WindowOpacity, StringFormat='{}{0:P0}'}"
                                  Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Slider Minimum="0.1" Maximum="1" Value="{Binding WindowOpacity}"
                           TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                    <CheckBox Content="始终置顶" IsChecked="{Binding WindowAlwaysOnTop}"
                             Margin="0,10,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 提醒设置 -->
            <GroupBox Header="提醒设置" Padding="10" Margin="0,0,0,15">
                <StackPanel>
                    <!-- 弹窗提醒 -->
                    <CheckBox Content="启用弹窗提醒" IsChecked="{Binding ReminderPopupEnabled}"
                             Margin="0,0,0,10"/>

                    <Grid Margin="20,0,0,10" Visibility="{Binding ReminderPopupEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="标题模板:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="{Binding PopupTitleTemplate}"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="内容模板:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="{Binding PopupContentTemplate}"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="持续时间:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="50" Text="{Binding PopupDurationSeconds}"
                                        VerticalContentAlignment="Center" TextAlignment="Right"/>
                                <TextBlock Text=" 秒" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 声音提醒 -->
                    <CheckBox Content="启用声音提醒" IsChecked="{Binding ReminderSoundEnabled}"
                             Margin="0,0,0,10"/>

                    <Grid Margin="20,0,0,0" Visibility="{Binding ReminderSoundEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="音量:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding ReminderVolume}"
                                   TickFrequency="10" IsSnapToTickEnabled="True"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="提示音:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="{Binding ReminderSoundPath}"
                                    IsReadOnly="True" Margin="0,0,5,0"/>
                            <Button Grid.Column="2" Content="浏览..." Command="{Binding BrowseSoundCommand}"
                                   Padding="10,5"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- 按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="恢复默认" Command="{Binding ResetCommand}"
                       Padding="15,8" Margin="0,0,10,0"/>
                <Button Content="保存设置" Command="{Binding SaveCommand}"
                       Style="{StaticResource PrimaryButton}" Padding="15,8"/>
            </StackPanel>

            <!-- 模板说明 -->
            <Border Background="#F0F0F0" CornerRadius="5" Padding="10" Margin="0,15,0,0">
                <StackPanel>
                    <TextBlock Text="模板变量说明:" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Text="{}{title} - 日程标题" FontSize="10" Foreground="#666" Margin="0,3,0,0"/>
                    <TextBlock Text="{}{time} - 提醒时间" FontSize="10" Foreground="#666"/>
                    <TextBlock Text="{}{date} - 提醒日期" FontSize="10" Foreground="#666"/>
                    <TextBlock Text="{}{description} - 日程描述" FontSize="10" Foreground="#666"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
